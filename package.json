    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
